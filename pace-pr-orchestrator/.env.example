# ─────────────────────────────────────────────────────────────────────────────
# PACE PR Orchestrator — Environment Variables
# Copy this file to .env and fill in real values.  Never commit .env to VCS.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Endpoint (required) ──────────────────────────────────────────────────
# IBM Watsonx credentials
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your_ibm_cloud_api_key
WATSONX_PROJECT_ID=your_watsonx_project_id

# Model identifier to use for LLM calls.
LLM_MODEL=ibm/granite-3-8b-instruct

# Optional secondary provider. Leave blank to disable failover.
LLM_FALLBACK_API_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_PROJECT_ID=

# ── GitHub Integration (optional) ────────────────────────────────────────────
# Personal Access Token (classic) or Fine-Grained Token with:
#   • pull_requests: write  (to post review comments)
#   • contents: read        (to fetch diffs)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional webhook signature secret. If blank, signature validation is disabled.
GITHUB_WEBHOOK_SECRET=

# ── Observability and run controls (optional) ─────────────────────────────────
AGENTOPS_API_KEY=
DRY_RUN=false
MAX_CONCURRENT_PRS=3
PR_QUEUE_TIMEOUT=10

# ── Tuning (optional — sensible defaults shown) ──────────────────────────────
# Per-request timeout for a single LLM call, in seconds.
LLM_TIMEOUT_SECONDS=100

# Number of retry attempts for transient LLM API failures.
LLM_MAX_RETRIES=3

# ── Server (optional) ────────────────────────────────────────────────────────
# Host and port the HTTP webhook server listens on.
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
